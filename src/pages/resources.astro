---
import Layout from '../layouts/Layout.astro';
import { CTASection } from '../components/sections/CTASection';
import { resources } from '../data/resources';

const seoTitle = "Energy Resources & Guides UK | Funding, Solar & Heat Pumps";
const seoDescription = "Explore Open Energy Services' comprehensive guides on UK home energy efficiency, solar panels, heat pump grants, insulation, and government funding schemes like ECO4 and BUS.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What energy grants are available in the UK?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The UK offers several energy grants, including the Boiler Upgrade Scheme (BUS) for heat pumps, the Energy Company Obligation (ECO4) for low-income households, and the Great British Insulation Scheme (GBIS) to improve home energy efficiency."
      }
    },
    {
      "@type": "Question",
      "name": "Am I eligible for free insulation under ECO4?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Eligibility for ECO4 depends on receiving certain qualifying benefits, such as Universal Credit or Pension Credit, and having a home with an EPC rating of D or below. Our ECO4 guide provides a full list of qualifying criteria."
      }
    },
    {
      "@type": "Question",
      "name": "How much is the Boiler Upgrade Scheme grant?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Boiler Upgrade Scheme (BUS) provides an upfront grant of £7,500 towards the cost and installation of an air source or ground source heat pump in England and Wales."
      }
    }
  ]
};

const fundingGuides = resources.filter(r => r.category === 'Funding' || r.category === 'Grants');
const solarGuides = resources.filter(r => r.category === 'Solar' || r.category === 'Commercial' || r.category === 'Heat Pumps');
---

<Layout 
  title={seoTitle}
  description={seoDescription}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="pt-32 pb-16 bg-bg-grey">
    <div class="container max-w-5xl mx-auto px-4">
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-primary-navy tracking-tighter mb-6">
          UK Energy Guides & Insights
        </h1>
        <p class="text-lg md:text-xl text-slate-600 mb-8 font-medium max-w-3xl mx-auto leading-relaxed">
          Navigate the complex world of UK energy efficiency with our expert-written resources. Whether you're looking to install solar panels, transition to a heat pump, or secure government funding for insulation, our guides provide the clarity you need.
        </p>
      </div>

      <div class="mb-16">
        <h2 class="text-3xl font-bold text-primary-navy mb-8 border-b border-slate-200 pb-4">Funding & Government Grants</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-left">
          {fundingGuides.map(guide => (
            <a href={`/resources/${guide.slug}`} class="block bg-white p-8 rounded-3xl border border-slate-100 hover:border-emerald/30 hover:shadow-xl transition-all group">
              <div class="inline-block px-3 py-1 bg-emerald-light text-emerald text-sm font-bold rounded-full mb-4">{guide.category}</div>
              <h3 class="text-2xl font-bold text-primary-navy mb-3 group-hover:text-emerald transition-colors tracking-tight">{guide.title}</h3>
              <p class="text-slate-600 font-medium leading-relaxed mb-6">{guide.description}</p>
              <span class="text-primary-navy font-bold flex items-center gap-2 group-hover:gap-3 transition-all">Read Guide &rarr;</span>
            </a>
          ))}
        </div>
      </div>

      <div class="mb-20">
        <h2 class="text-3xl font-bold text-primary-navy mb-8 border-b border-slate-200 pb-4">Solar & Renewable Tech</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-left">
          {solarGuides.map(guide => (
            <a href={`/resources/${guide.slug}`} class="block bg-white p-8 rounded-3xl border border-slate-100 hover:border-emerald/30 hover:shadow-xl transition-all group">
              <div class="inline-block px-3 py-1 bg-emerald-light text-emerald text-sm font-bold rounded-full mb-4">{guide.category}</div>
              <h3 class="text-2xl font-bold text-primary-navy mb-3 group-hover:text-emerald transition-colors tracking-tight">{guide.title}</h3>
              <p class="text-slate-600 font-medium leading-relaxed mb-6">{guide.description}</p>
              <span class="text-primary-navy font-bold flex items-center gap-2 group-hover:gap-3 transition-all">Read Guide &rarr;</span>
            </a>
          ))}
          <a href="/eligibility" class="block bg-white p-8 rounded-3xl border border-emerald/20 bg-emerald/5 hover:border-emerald/50 hover:shadow-xl transition-all group">
            <div class="inline-block px-3 py-1 bg-emerald text-white text-sm font-bold rounded-full mb-4">Tool</div>
            <h3 class="text-2xl font-bold text-primary-navy mb-3 group-hover:text-emerald transition-colors tracking-tight">Check Your Energy Upgrade Eligibility</h3>
            <p class="text-slate-600 font-medium leading-relaxed mb-6">Use our free, 60-second assessment tool to find out which solar, heating, or insulation grants your UK property qualifies for.</p>
            <span class="text-emerald font-bold flex items-center gap-2 group-hover:gap-3 transition-all">Check Now &rarr;</span>
          </a>
        </div>
      </div>

      <article class="bg-white rounded-3xl p-8 md:p-12 shadow-sm border border-slate-100 mb-16">
        <h2 class="text-3xl font-bold text-primary-navy mb-6">Why Energy Efficiency Matters for UK Homes</h2>
        <div class="text-slate-600 text-lg leading-relaxed space-y-6">
          <p>
            Upgrading your home's energy efficiency is no longer just about environmental responsibility; it's a crucial step in managing rising living costs. 
            With energy prices fluctuating across the UK, investments in <strong class="text-primary-navy font-bold">solar panels</strong>, <strong class="text-primary-navy font-bold">air source heat pumps</strong>, and robust <strong class="text-primary-navy font-bold">insulation</strong> provide long-term financial security.
          </p>
          <p>
            At Open Energy Services, we act as your independent energy consultancy. We aren't tied to a single manufacturer or installer. 
            Instead, we analyze your property's specific needs, identify available <strong class="text-primary-navy font-bold">government funding</strong> (like ECO4, GBIS, or BUS), 
            and connect you with our network of vetted, accredited installation partners nationwide.
          </p>
          <h3 class="text-2xl font-bold text-primary-navy mt-10 mb-4">Our Commitment to Quality</h3>
          <p>
            Every resource in this hub is designed to empower homeowners, landlords, and businesses with factual, up-to-date information. 
            Before you make a decision on renewables, we want you to understand the technology, the costs, the savings, and the grants available to you.
          </p>
        </div>
      </article>

      <div class="mb-16">
        <h2 class="text-3xl font-bold text-primary-navy mb-8 text-center">Frequently Asked Questions</h2>
        <div class="space-y-6 max-w-3xl mx-auto">
          <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
            <h3 class="font-bold text-xl text-primary-navy mb-3">
              What energy grants are available in the UK?
            </h3>
            <p class="text-slate-600 leading-relaxed">
              The UK offers several energy grants, including the Boiler Upgrade Scheme (BUS) for heat pumps, the Energy Company Obligation (ECO4) for low-income households, and the Great British Insulation Scheme (GBIS) to improve home energy efficiency.
            </p>
          </div>
          <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
            <h3 class="font-bold text-xl text-primary-navy mb-3">
              Am I eligible for free insulation under ECO4?
            </h3>
            <p class="text-slate-600 leading-relaxed">
              Eligibility for ECO4 depends on receiving certain qualifying benefits, such as Universal Credit or Pension Credit, and having a home with an EPC rating of D or below. Our ECO4 guide provides a full list of qualifying criteria.
            </p>
          </div>
          <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
            <h3 class="font-bold text-xl text-primary-navy mb-3">
              How much is the Boiler Upgrade Scheme grant?
            </h3>
            <p class="text-slate-600 leading-relaxed">
              The Boiler Upgrade Scheme (BUS) provides an upfront grant of £7,500 towards the cost and installation of an air source or ground source heat pump in England and Wales.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <CTASection client:visible />
</Layout>