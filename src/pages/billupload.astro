---
import '../index.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Upload Your Energy Bill | Open Energy Services</title>
    <!-- Phosphor Icons -->
    <script is:inline src="https://unpkg.com/@phosphor-icons/web"></script>
    <style>
        /* Smooth transitions based on user preferences */
        .spring-transition {
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
    </style>
</head>
<body class="bg-gray-50 min-h-screen text-gray-900 font-sans selection:bg-brand-500 selection:text-white pb-20">
    
    <!-- Header -->
    <header class="bg-white border-b border-gray-200 px-6 py-4 sticky top-0 z-10 shadow-sm">
        <div class="max-w-md mx-auto flex items-center justify-between">
            <h1 class="text-xl font-bold text-gray-900 tracking-tight">Open Energy Services</h1>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-md mx-auto px-6 py-8">
        <div class="mb-8">
            <h2 class="text-2xl font-bold mb-2">Upload your bills</h2>
            <p class="text-gray-500 text-sm">Please take clear photos of all pages of your recent energy bill, or upload a PDF.</p>
        </div>

        <!-- Optional Identifier -->
        <div class="mb-6">
            <label for="userName" class="block text-sm font-medium text-gray-700 mb-1">Your Name (Optional)</label>
            <input 
                type="text" 
                id="userName" 
                placeholder="e.g. John Doe" 
                class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all"
            >
        </div>

        <!-- Upload Area -->
        <div 
            id="dropZone"
            class="bg-white border-2 border-dashed border-gray-300 rounded-2xl p-8 text-center cursor-pointer hover:border-brand-500 hover:bg-brand-50 transition-colors duration-200"
            onclick="document.getElementById('fileInput').click()"
        >
            <i class="ph ph-camera text-4xl text-brand-500 mb-3"></i>
            <p class="text-base font-medium text-gray-900 mb-1">Tap to take photo or browse</p>
            <p class="text-xs text-gray-500">Supports images and PDFs</p>
        </div>

        <input 
            type="file" 
            id="fileInput" 
            class="hidden" 
            multiple 
            accept="image/*,application/pdf"
        >

        <!-- Selected Files List -->
        <div id="fileList" class="mt-6 space-y-3">
            <!-- Files will be injected here via JS -->
        </div>

        <!-- Submit Button (Hidden initially) -->
        <div id="submitContainer" class="mt-8 hidden">
            <button 
                id="submitBtn"
                class="w-full bg-brand-500 hover:bg-brand-600 text-white font-semibold py-4 px-6 rounded-xl shadow-lg shadow-brand-500/30 active:scale-[0.98] transition-all duration-200 flex items-center justify-center gap-2"
            >
                <i class="ph ph-upload-simple text-xl"></i>
                Submit Bills
            </button>
        </div>
    </main>

    <script>
        const fileInput = document.getElementById('fileInput');
        const fileList = document.getElementById('fileList');
        const submitContainer = document.getElementById('submitContainer');
        const submitBtn = document.getElementById('submitBtn');
        const dropZone = document.getElementById('dropZone');
        
        // Store selected files
        let selectedFiles = [];

        // Handle file selection
        if (fileInput) {
            fileInput.addEventListener('change', (e) => {
                const target = e.target;
                if (!target || !target.files) return;
                const newFiles = Array.from(target.files);
                selectedFiles = [...selectedFiles, ...newFiles];
                updateFileDisplay();
                // Reset input so the same file can be selected again if removed
                target.value = ''; 
            });
        }

        // Remove file - must be assigned to window to be accessible from inline onclick handler
        window.removeFile = function(index) {
            selectedFiles.splice(index, 1);
            updateFileDisplay();
        }

        // Format file size
        function formatBytes(bytes, decimals = 2) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const dm = decimals < 0 ? 0 : decimals;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
        }

        // Update UI
        function updateFileDisplay() {
            if (!fileList || !submitContainer || !dropZone) return;
            
            if (selectedFiles.length === 0) {
                fileList.innerHTML = '';
                submitContainer.classList.add('hidden');
                const pTag = dropZone.querySelector('p.text-base');
                if (pTag) pTag.textContent = 'Tap to take photo or browse';
                return;
            }

            const pTag = dropZone.querySelector('p.text-base');
            if (pTag) pTag.textContent = 'Tap to add more files';
            submitContainer.classList.remove('hidden');
            
            fileList.innerHTML = selectedFiles.map((file, index) => {
                const isImage = file.type.startsWith('image/');
                const icon = isImage ? 'ph-image' : 'ph-file-pdf';
                
                return `
                    <div class="bg-white border border-gray-100 p-3 rounded-xl shadow-sm flex items-center gap-3 spring-transition">
                        <div class="bg-brand-50 p-2 rounded-lg text-brand-600">
                            <i class="ph ${icon} text-xl"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-gray-900 truncate">${file.name}</p>
                            <p class="text-xs text-gray-500">${formatBytes(file.size)}</p>
                        </div>
                        <button 
                            onclick="window.removeFile(${index})"
                            class="p-2 text-gray-400 hover:text-red-500 transition-colors"
                        >
                            <i class="ph ph-trash text-lg"></i>
                        </button>
                    </div>
                `;
            }).join('');
        }

        // Handle Submit
        if (submitBtn) {
            submitBtn.addEventListener('click', async () => {
                if (selectedFiles.length === 0) return;
                
                const originalText = submitBtn.innerHTML;
                submitBtn.innerHTML = '<i class="ph ph-spinner animate-spin text-xl"></i> Uploading...';
                submitBtn.disabled = true;
                submitBtn.classList.add('opacity-80', 'cursor-not-allowed');

                try {
                    const formData = new FormData();
                    const userNameInput = document.getElementById('userName');
                    const userName = (userNameInput && userNameInput.value.trim()) || 'Unknown User';
                    
                    // FormSubmit required fields
                    formData.append('_subject', `New Energy Bill Upload from ${userName}`);
                    formData.append('Name', userName);
                    
                    // Append each file with a unique name so they all get attached
                    selectedFiles.forEach((file, index) => {
                        formData.append(`Bill_Document_${index + 1}`, file);
                    });
                    
                    // Send to FormSubmit using AJAX
                    const response = await fetch('https://formsubmit.co/ajax/Jake@openlead.co.uk', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'Accept': 'application/json'
                        }
                    });
                    
                    const result = await response.json();
                    
                    if (!result.success) {
                        throw new Error(result.message || 'Upload failed');
                    }
                    
                    // Success state
                    submitBtn.innerHTML = '<i class="ph ph-check-circle text-xl"></i> Sent Successfully!';
                    submitBtn.classList.replace('bg-brand-500', 'bg-green-500');
                    submitBtn.classList.replace('hover:bg-brand-600', 'hover:bg-green-600');
                    submitBtn.classList.replace('shadow-brand-500/30', 'shadow-green-500/30');
                    
                    // Reset after 3 seconds
                    setTimeout(() => {
                        selectedFiles = [];
                        if (userNameInput) userNameInput.value = '';
                        updateFileDisplay();
                        submitBtn.innerHTML = originalText;
                        submitBtn.disabled = false;
                        submitBtn.classList.remove('opacity-80', 'cursor-not-allowed');
                        submitBtn.classList.replace('bg-green-500', 'bg-brand-500');
                        submitBtn.classList.replace('hover:bg-green-600', 'hover:bg-brand-600');
                        submitBtn.classList.replace('shadow-green-500/30', 'shadow-brand-500/30');
                    }, 3000);

                } catch (error) {
                    console.error('Upload failed:', error);
                    alert('Upload failed. Please check your connection and try again.');
                    submitBtn.innerHTML = originalText;
                    submitBtn.disabled = false;
                    submitBtn.classList.remove('opacity-80', 'cursor-not-allowed');
                }
            });
        }
    </script>
</body>
</html>