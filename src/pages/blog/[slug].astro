---
import Layout from '../../layouts/Layout.astro';
import { CTASection } from '../../components/sections/CTASection';
import { getCollection } from 'astro:content';
import { Calendar, User, ArrowLeft } from 'lucide-react';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={`${entry.data.title} | Open Energy Services`} description={entry.data.description}>
  <article class="bg-bg-grey pt-32 pb-24">
    <div class="container max-w-4xl mx-auto px-4">
      <a href="/blog" class="inline-flex items-center text-emerald font-semibold mb-8 hover:text-emerald-600 transition-colors">
        <ArrowLeft size={20} class="mr-2" /> Back to all articles
      </a>
      
      <header class="mb-12 text-center">
        <h1 class="text-3xl md:text-5xl font-bold text-primary-navy mb-6 tracking-tight leading-tight">
          {entry.data.title}
        </h1>
        <div class="flex items-center justify-center gap-6 text-slate-500 font-medium">
          <div class="flex items-center gap-2">
            <Calendar size={18} />
            <time datetime={entry.data.pubDate.toISOString()}>
              {entry.data.pubDate.toLocaleDateString('en-GB', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          </div>
          <div class="flex items-center gap-2">
            <User size={18} />
            <span>{entry.data.author}</span>
          </div>
        </div>
      </header>

      {entry.data.image && (
        <div class="rounded-3xl overflow-hidden shadow-2xl mb-16 aspect-video">
          <img 
            src={entry.data.image} 
            alt={entry.data.title}
            class="w-full h-full object-cover"
            width="800"
            height="450"
            loading="eager"
          />
        </div>
      )}

      <div class="prose prose-lg md:prose-xl prose-slate max-w-none prose-headings:text-primary-navy prose-a:text-emerald prose-a:no-underline hover:prose-a:underline prose-img:rounded-2xl mx-auto bg-white p-8 md:p-16 rounded-[2rem] shadow-glass border border-slate-100">
        <Content />
      </div>
    </div>
  </article>
  <CTASection client:visible />
</Layout>
