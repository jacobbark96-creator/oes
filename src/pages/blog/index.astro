---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { ArrowRight, Calendar } from 'lucide-react';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout 
  title="Energy Insights & News | Open Energy Services"
  description="Stay updated with the latest news, guides, and insights on solar panels, heat pumps, government funding, and energy efficiency in the UK."
>
  <div class="pt-32 pb-24 bg-bg-grey min-h-screen">
    <div class="container max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-primary-navy mb-6 tracking-tight">
          Energy Insights
        </h1>
        <p class="text-lg text-slate-600 font-medium max-w-2xl mx-auto">
          Expert advice, industry news, and comprehensive guides to help you navigate your journey to a more energy-efficient property.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedPosts.map((post) => (
          <a href={`/blog/${post.slug}`} class="group flex flex-col bg-white rounded-3xl shadow-glass border border-slate-100 overflow-hidden hover:shadow-xl transition-all duration-300">
            {post.data.image && (
              <div class="relative h-48 overflow-hidden bg-slate-100">
                <img 
                  src={post.data.image} 
                  alt={post.data.title}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                  width="400"
                  height="200"
                />
              </div>
            )}
            <div class="p-8 flex flex-col flex-grow">
              <div class="flex items-center gap-2 text-sm text-emerald font-semibold mb-4">
                <Calendar size={16} />
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-GB', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
              </div>
              <h2 class="text-xl font-bold text-primary-navy mb-3 group-hover:text-emerald transition-colors leading-tight">
                {post.data.title}
              </h2>
              <p class="text-slate-600 mb-6 flex-grow line-clamp-3">
                {post.data.description}
              </p>
              <div class="flex items-center text-primary-navy font-bold text-sm group-hover:text-emerald transition-colors mt-auto">
                Read Article <ArrowRight size={16} class="ml-2 transition-transform group-hover:translate-x-1" />
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
