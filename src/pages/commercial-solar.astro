---
import Layout from '../layouts/Layout.astro';
import { motion } from 'framer-motion';
import { Building2, ArrowRight, CheckCircle2 } from 'lucide-react';
---

<Layout 
  title="Commercial Solar Panels | Open Energy Solutions" 
  description="Could your business reduce its energy costs with solar? OES provides independent guidance and connects businesses with trusted installation partners."
>
  <div class="min-h-screen bg-bg-grey">
    <div class="relative overflow-hidden bg-primary-navy py-24 lg:py-32">
      <div class="absolute inset-0 z-0 opacity-10">
        <svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="commercial-grid" width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M0 40L40 0H20L0 20M40 40V20L20 40" stroke="currentColor" stroke-width="1" fill="none" />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#commercial-grid)" />
        </svg>
      </div>

      <div class="container relative z-10 max-w-6xl">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16 items-center">
          <div class="text-white">
            <h1 class="mb-6 text-[clamp(2.5rem,5vw,4rem)] font-bold leading-tight tracking-tight">
              Could your business reduce its energy costs with <span class="text-emerald">solar?</span>
            </h1>
            <p class="mb-10 text-lg leading-relaxed text-slate-300">
              Find out whether commercial solar could work for your business. OES provides independent guidance and connects suitable businesses with trusted installation partners.
            </p>
            <div class="flex flex-col gap-4 sm:flex-row">
              <a 
                href="#eligibility-form"
                class="inline-flex items-center justify-center gap-2 rounded-2xl bg-emerald px-8 py-4 text-base font-semibold text-white shadow-soft transition-all hover:bg-emerald-light hover:text-emerald"
              >
                Check My Eligibility
                <ArrowRight size={20} />
              </a>
            </div>
            <p class="mt-4 text-sm text-slate-400 font-medium">Free • No obligation • Takes around 60 seconds</p>
            
            <div class="mt-12 flex flex-col gap-4">
              <div class="flex items-center gap-3">
                <CheckCircle2 class="text-emerald" size={20} />
                <span class="text-slate-300">Independent Assessment</span>
              </div>
              <div class="flex items-center gap-3">
                <CheckCircle2 class="text-emerald" size={20} />
                <span class="text-slate-300">Funding & Finance Options</span>
              </div>
              <div class="flex items-center gap-3">
                <CheckCircle2 class="text-emerald" size={20} />
                <span class="text-slate-300">Trusted Installer Network</span>
              </div>
            </div>
          </div>

          <div id="eligibility-form" class="relative">
            <div class="rounded-3xl bg-white p-8 shadow-2xl">
              <h2 class="mb-6 text-2xl font-bold text-primary-navy">Business Energy Assessment</h2>
              <form class="space-y-5" action="/api/lead-capture" method="POST">
                <input type="hidden" name="campaign" value="commercial-solar" />
                <div class="grid gap-5 sm:grid-cols-2">
                  <div>
                    <label class="mb-2 block text-sm font-medium text-slate-700">First Name</label>
                    <input type="text" required class="w-full rounded-xl border border-slate-200 px-4 py-3 focus:border-emerald focus:outline-none focus:ring-2 focus:ring-emerald/20" />
                  </div>
                  <div>
                    <label class="mb-2 block text-sm font-medium text-slate-700">Last Name</label>
                    <input type="text" required class="w-full rounded-xl border border-slate-200 px-4 py-3 focus:border-emerald focus:outline-none focus:ring-2 focus:ring-emerald/20" />
                  </div>
                </div>
                <div>
                  <label class="mb-2 block text-sm font-medium text-slate-700">Business Name</label>
                  <input type="text" required class="w-full rounded-xl border border-slate-200 px-4 py-3 focus:border-emerald focus:outline-none focus:ring-2 focus:ring-emerald/20" />
                </div>
                <div>
                  <label class="mb-2 block text-sm font-medium text-slate-700">Monthly Electricity Spend (£)</label>
                  <select required class="w-full rounded-xl border border-slate-200 px-4 py-3 focus:border-emerald focus:outline-none focus:ring-2 focus:ring-emerald/20">
                    <option value="">Please select...</option>
                    <option value="0-500">Under £500</option>
                    <option value="500-2000">£500 - £2,000</option>
                    <option value="2000-5000">£2,000 - £5,000</option>
                    <option value="5000+">Over £5,000</option>
                  </select>
                </div>
                <div class="grid gap-5 sm:grid-cols-2">
                  <div>
                    <label class="mb-2 block text-sm font-medium text-slate-700">Email Address</label>
                    <input type="email" required class="w-full rounded-xl border border-slate-200 px-4 py-3 focus:border-emerald focus:outline-none focus:ring-2 focus:ring-emerald/20" />
                  </div>
                  <div>
                    <label class="mb-2 block text-sm font-medium text-slate-700">Phone Number</label>
                    <input type="tel" required class="w-full rounded-xl border border-slate-200 px-4 py-3 focus:border-emerald focus:outline-none focus:ring-2 focus:ring-emerald/20" />
                  </div>
                </div>
                <button type="submit" class="w-full rounded-xl bg-primary-navy px-4 py-4 font-bold text-white transition-all hover:bg-primary-dark">
                  Check My Eligibility
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>