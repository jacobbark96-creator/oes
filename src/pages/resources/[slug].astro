---
import Layout from '../../layouts/Layout.astro';
import { CTASection } from '../../components/sections/CTASection';
import { resources } from '../../data/resources';

export function getStaticPaths() {
  return resources.map(resource => ({
    params: { slug: resource.slug },
    props: { resource },
  }));
}

const { resource } = Astro.props;

// Generate FAQ Schema dynamically based on H2s in the content
// This is a simple approximation to get rich snippets for the guide pages.
const h2Regex = /<h2>(.*?)<\/h2>[\s\S]*?<p>(.*?)<\/p>/g;
let match;
const faqItems = [];

while ((match = h2Regex.exec(resource.content)) !== null) {
  // Only add if it looks like a question (optional, but good practice, here we'll just add all H2/P pairs as FAQ to ensure coverage)
  faqItems.push({
    "@type": "Question",
    "name": match[1].replace(/<[^>]*>?/gm, ''), // strip html
    "acceptedAnswer": {
      "@type": "Answer",
      "text": match[2].replace(/<[^>]*>?/gm, '')
    }
  });
}

const faqSchema = faqItems.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems
} : null;
---

<Layout 
  title={`${resource.title} | Open Energy Services`} 
  description={resource.description}
>
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  
  <div class="pt-32 pb-16 bg-bg-grey">
    <div class="container max-w-3xl mx-auto text-center px-4">
      <div class="inline-block px-3 py-1 bg-emerald-light text-emerald text-sm font-bold rounded-full mb-6">
        {resource.category}
      </div>
      <h1 class="text-4xl md:text-5xl font-black text-primary-navy tracking-tighter mb-6">
        {resource.title}
      </h1>
      <p class="text-lg text-slate-600 font-medium leading-relaxed mb-8">
        {resource.description}
      </p>
    </div>
  </div>

  <article class="py-16 md:py-24 bg-white">
    <div class="container max-w-3xl mx-auto px-4">
      <div class="prose prose-lg prose-slate prose-headings:text-primary-navy prose-h2:font-bold prose-h2:tracking-tight prose-a:text-emerald max-w-none space-y-6" set:html={resource.content} />
      
      <div class="mt-20 bg-bg-grey p-10 rounded-3xl border border-slate-100 text-center shadow-sm">
        <h3 class="text-3xl font-bold text-primary-navy mb-4">Want to see if you qualify?</h3>
        <p class="text-slate-600 mb-8 text-lg max-w-xl mx-auto">Take our quick assessment to check your eligibility for funding schemes, solar panels, and heat pumps.</p>
        <a href="/eligibility?utm_source=internal&utm_medium=website&utm_campaign=guide_cta" class="inline-block bg-primary-navy text-white px-8 py-4 rounded-xl font-bold hover:bg-primary-dark transition-colors shadow-lg shadow-primary-navy/20">
          Check My Eligibility
        </a>
      </div>
    </div>
  </article>

  <CTASection client:visible />
</Layout>
